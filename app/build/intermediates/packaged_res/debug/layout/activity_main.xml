<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#1a1a2e">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔧 Elmer"
        android:textSize="32sp"
        android:textColor="#ff6b35"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Диагностика авто через ИИ"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v?"
        android:textSize="11sp"
        android:textColor="#555"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_test"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧪 ТЕСТ (всё локально)"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:backgroundTint="#4CAF50"
        android:padding="14dp"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/cb_full_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Полная диагностика (VIN + DTC + 7 PID)"
        android:textSize="13sp"
        android:textColor="#ffffff"
        android:buttonTint="#2196F3"
        android:checked="false"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btn_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 ИСТОРИЯ"
        android:textSize="13sp"
        android:textColor="#ffffff"
        android:backgroundTint="#9C27B0"
        android:padding="10dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_script"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="� ДИАГНОСТИКА"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:backgroundTint="#2196F3"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Оверлей для промптов водителю -->
    <TextView
        android:id="@+id/tv_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textColor="#FFD700"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#88000000"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0d0d1a"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Готов"
            android:textSize="12sp"
            android:textColor="#e0e0e0"
            android:fontFamily="monospace"
            android:padding="8dp" />

    </ScrollView>

    <CheckBox
        android:id="@+id/cb_mock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="mock"
        android:textSize="10sp"
        android:textColor="#444444"
        android:buttonTint="#444444"
        android:checked="false"
        android:layout_gravity="end"
        android:layout_marginTop="4dp" />

</LinearLayout>
