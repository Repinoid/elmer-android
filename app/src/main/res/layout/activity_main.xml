<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:gravity="center_horizontal" android:background="#1a1a2e">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🔧 elmAI" android:textSize="22sp" android:textColor="#ff6b35"
        android:layout_marginTop="8dp" android:layout_marginBottom="2dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="6dp">
        <TextView android:id="@+id/tv_version" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="v?" android:textSize="10sp" android:textColor="#555" />
        <TextView android:id="@+id/tv_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="12sp" android:textColor="#ff6b35"
            android:fontFamily="monospace" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout android:id="@+id/indicators" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="6dp">
        <TextView android:id="@+id/ind_server" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="📡 🔴" android:textSize="11sp" android:gravity="center"
            android:textColor="#aaaaaa" android:padding="4dp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/ind_elm" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🔌 🔴" android:textSize="11sp" android:gravity="center"
            android:textColor="#aaaaaa" android:padding="4dp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/ind_ecu" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🚗 🔴" android:textSize="11sp" android:gravity="center"
            android:textColor="#aaaaaa" android:padding="4dp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/ind_llm" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🧠 🔴" android:textSize="11sp" android:gravity="center"
            android:textColor="#aaaaaa" android:padding="4dp" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <Button android:id="@+id/btn_action" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="⚠️ ОШИБКИ" android:textSize="14sp" android:textColor="#ffffff"
        android:backgroundTint="#FF5722" android:padding="12dp" android:layout_marginBottom="4dp" />

    <ScrollView android:id="@+id/scroll_output" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#0d0d1a" android:padding="6dp">
        <TextView android:id="@+id/tv_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Готов" android:textSize="11sp" android:textColor="#e0e0e0"
            android:fontFamily="monospace" android:padding="6dp" />
    </ScrollView>

    <Button android:id="@+id/btn_history" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📋 История" android:textSize="12sp" android:textColor="#ffffff"
        android:backgroundTint="#9C27B0" android:padding="8dp" android:layout_marginTop="2dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <EditText android:id="@+id/et_user_input" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Что беспокоит? Чем подробнее — тем лучше"
            android:textColor="#e0e0e0" android:textColorHint="#555555" android:textSize="12sp"
            android:padding="8dp" android:background="@drawable/edit_bg"
            android:inputType="text|textMultiLine" android:minLines="2" android:maxLines="2" android:gravity="top" />
        <Button android:id="@+id/btn_send" android:layout_width="48dp" android:layout_height="48dp"
            android:text="➤" android:textSize="18sp" android:textColor="#ffffff"
            android:backgroundTint="#ff6b35" android:padding="0dp" android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>