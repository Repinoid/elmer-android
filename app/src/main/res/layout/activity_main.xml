<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal"
    android:background="#1a1a2e">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔧 elmAI"
        android:textSize="24sp"
        android:textColor="#ff6b35"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v?"
        android:textSize="10sp"
        android:textColor="#555"
        android:layout_marginBottom="8dp" />

    <!-- Главные кнопки: Ошибки + Диагностика -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <Button
            android:id="@+id/btn_dtc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️ ОШИБКИ"
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:backgroundTint="#FF5722"
            android:padding="10dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_script"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍 ДИАГНОСТИКА"
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:backgroundTint="#2196F3"
            android:padding="10dp"
            android:enabled="false" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_dtc_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👆 Сначала считай ошибки"
        android:textSize="10sp"
        android:textColor="#FF5722"
        android:gravity="center"
        android:layout_marginBottom="4dp"
        android:visibility="visible" />

    <CheckBox
        android:id="@+id/cb_full_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Полная диагностика (VIN + DTC + 7 PID)"
        android:textSize="12sp"
        android:textColor="#cccccc"
        android:buttonTint="#2196F3"
        android:checked="false"
        android:layout_marginBottom="6dp" />

    <!-- Проверки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#151525"
        android:padding="6dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Проверка"
            android:textSize="10sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📡 Сервер"
                android:textSize="10sp"
                android:textColor="#aaaaaa"
                android:backgroundTint="#2a2a3e"
                android:padding="6dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_check_elm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔌 ELM"
                android:textSize="10sp"
                android:textColor="#aaaaaa"
                android:backgroundTint="#2a2a3e"
                android:padding="6dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_check_ecu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚗 ЭБУ"
                android:textSize="10sp"
                android:textColor="#aaaaaa"
                android:backgroundTint="#2a2a3e"
                android:padding="6dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- История -->
    <Button
        android:id="@+id/btn_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 История"
        android:textSize="11sp"
        android:textColor="#ffffff"
        android:backgroundTint="#9C27B0"
        android:padding="8dp"
        android:layout_marginBottom="4dp" />

    <!-- Описание авто -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 Что за машина? (можно пропустить)"
            android:textSize="11sp"
            android:textColor="#888888" />

        <EditText
            android:id="@+id/et_car_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Марка, модель, год, двигатель — что знаете"
            android:textColor="#e0e0e0"
            android:textColorHint="#444444"
            android:textSize="12sp"
            android:padding="8dp"
            android:background="@drawable/edit_bg"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Чем полнее информация — тем точнее диагноз."
            android:textSize="9sp"
            android:textColor="#555555"
            android:gravity="end" />

    </LinearLayout>

    <!-- Оверлей для промптов водителю -->
    <TextView
        android:id="@+id/tv_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textColor="#FFD700"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#88000000"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_marginBottom="4dp" />

    <!-- Вывод -->
    <ScrollView
        android:id="@+id/scroll_output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0d0d1a"
        android:padding="6dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Готов"
            android:textSize="11sp"
            android:textColor="#e0e0e0"
            android:fontFamily="monospace"
            android:padding="6dp" />

    </ScrollView>

    <!-- Кнопка закрытия после диагноза -->
    <Button
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✕ Закрыть"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:backgroundTint="#d32f2f"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

    <!-- Поле ввода + отправить -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/et_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Жалобы, вопросы к LLM..."
            android:textColor="#e0e0e0"
            android:textColorHint="#555555"
            android:textSize="13sp"
            android:padding="10dp"
            android:background="@drawable/edit_bg"
            android:inputType="text"
            android:maxLines="2" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="➤"
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:backgroundTint="#ff6b35"
            android:padding="0dp"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>
